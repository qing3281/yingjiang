{
  "_说明": "Wan 2.2 图生视频（5B ti2v）。占位符：__IMAGE__ 图名，__POS__ 正向，__NEG__ 负向，__SEED__ 种子。宽高帧数直接写死在这里，由引擎.图生视频(宽=/高=/帧数=) 覆盖。",

  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "wan2.2_ti2v_5B_fp16.safetensors",
      "weight_dtype": "default"
    },
    "_meta": { "title": "加载视频模型" }
  },

  "2": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": ["1", 0],
      "shift": 8.0
    },
    "_meta": { "title": "采样算法" }
  },

  "3": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "wan",
      "device": "default"
    },
    "_meta": { "title": "加载文本编码器" }
  },

  "4": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "wan2.2_vae.safetensors"
    },
    "_meta": { "title": "加载VAE" }
  },

  "5": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "__IMAGE__",
      "upload": "image"
    },
    "_meta": { "title": "首帧图" }
  },

  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "__POS__",
      "clip": ["3", 0]
    },
    "_meta": { "title": "正向提示词" }
  },

  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "__NEG__",
      "clip": ["3", 0]
    },
    "_meta": { "title": "负向提示词" }
  },

  "8": {
    "class_type": "Wan22ImageToVideoLatent",
    "inputs": {
      "vae": ["4", 0],
      "start_image": ["5", 0],
      "width": 832,
      "height": 480,
      "length": 49,
      "batch_size": 1
    },
    "_meta": { "title": "图像转视频Latent" }
  },

  "9": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["2", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["8", 0],
      "seed": "__SEED__",
      "steps": 20,
      "cfg": 5.0,
      "sampler_name": "uni_pc",
      "scheduler": "simple",
      "denoise": 1.0
    },
    "_meta": { "title": "K采样器" }
  },

  "10": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["9", 0],
      "vae": ["4", 0]
    },
    "_meta": { "title": "VAE解码" }
  },

  "11": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["10", 0],
      "fps": 24
    },
    "_meta": { "title": "合成视频" }
  },

  "12": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["11", 0],
      "filename_prefix": "影匠",
      "format": "auto",
      "codec": "auto"
    },
    "_meta": { "title": "保存视频" }
  }
}
