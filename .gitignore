# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 生成物 —— 作品和缓存不进库（图/视频会越滚越大）
作品/*/
# 但保留示例作品（给人看这东西能出什么）
!作品/示例/
!作品/示例/**
!作品/README.md
assets/角色/*.png
*.log

# 本机合成中间物（不上传，重跑就有）
段/
片/

# ComfyUI 的临时上传（引擎会自动重命名去重，不需要留）
input/

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
desktop.ini

# 模型（太大，且各自机器不同）
*.safetensors
*.ckpt
*.pt
*.pth
*.gguf

# ★ 音色包 —— 778 MB，且是第三方转卖的合集，绝对不能上传
# 用 音色/** 而不是 音色/ —— 后者会把整个目录锁死，! 例外捞不回子文件
音色/**
*.mp3
*.wav
*.flac
*.m4a
*.ogg
# 但音色库的编目清单要留（只有元数据，没有音频）
!音色/音色库.json
!音色/音色库.html

# 临时文件
_提交信息.txt
