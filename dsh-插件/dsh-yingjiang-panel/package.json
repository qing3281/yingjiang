{
  "name": "dsh-yingjiang-panel",
  "version": "0.1.0",
  "private": true,
  "description": "影匠依据面板 —— 在 DSH 右侧栏显示「这一轮我读了哪些文件、做了哪些动作」。数据来自 DSH 自己写的 tool/call 记录。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  }
}
