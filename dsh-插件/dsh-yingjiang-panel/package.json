{
  "name": "dsh-yingjiang-panel",
  "version": "0.1.0",
  "private": true,
  "description": "影匠面板 —— 在 DSH 侧栏放「记忆」「依据」两个面板，里面是本地网页。数据来自 DSH 自己写的 tool/call 记录。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    },
    "manifestVersion": 1
  }
}
