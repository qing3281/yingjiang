{
  "_说明": "MiniMax-H3 首尾帧 → 视频+音频。给两张图（这一格的起手画面 + 下一格的起手画面），模型补中间。**这是让片子不再靠交叉溶解硬接的关键**：以前每一格各出各的，接缝只能靠转场糊过去；现在这一格**结束的那一帧就是下一格开始的那一帧**，切口是缝上的。占位符 __IMAGE__（首帧）/ __LAST__（尾帧）/ __POS__ / __SEED__ 由 引擎.图生视频 换。",

  "6": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors", "weight_dtype": "default" },
    "_meta": { "title": "MiniMax-H3 fl2va（首尾帧→视频+音频）" }
  },

  "121": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["6", 0],
      "lora_name": "minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors",
      "strength_model": 1.0
    },
    "_meta": { "title": "8 步加速 LoRA" }
  },

  "13": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors", "type": "minimax", "device": "default" },
    "_meta": { "title": "文本/视觉编码器" }
  },

  "11": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_video_vae_int8_convrot.safetensors" },
    "_meta": { "title": "视频 VAE" }
  },

  "24": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_audio_vae_fp32.safetensors" },
    "_meta": { "title": "音频 VAE" }
  },

  "5": {
    "class_type": "LoadImage",
    "inputs": { "image": "__IMAGE__", "upload": "image" },
    "_meta": { "title": "首帧（这一格的起手画面）" }
  },

  "7": {
    "class_type": "LoadImage",
    "inputs": { "image": "__LAST__", "upload": "image" },
    "_meta": { "title": "尾帧（下一格的起手画面）—— 接缝就缝在这里" }
  },

  "104": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "clip": ["13", 0],
      "vae": ["11", 0],
      "prompt": "__POS__",
      "width": 832,
      "height": 480,
      "length": 124,
      "first_frame": ["5", 0],
      "last_frame": ["7", 0]
    },
    "_meta": { "title": "首尾帧转视频" }
  },

  "15": { "class_type": "RandomNoise", "inputs": { "noise_seed": "__SEED__" }, "_meta": { "title": "噪声种子" } },
  "17": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "res_multistep" }, "_meta": { "title": "采样器" } },
  "9": {
    "class_type": "BasicScheduler",
    "inputs": { "model": ["121", 0], "scheduler": "simple", "steps": 8, "denoise": 1.0 },
    "_meta": { "title": "8 步（配 8 步 LoRA）" }
  },
  "16": {
    "class_type": "BasicGuider",
    "inputs": { "model": ["121", 0], "conditioning": ["104", 0] },
    "_meta": { "title": "引导" }
  },
  "14": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["15", 0], "guider": ["16", 0], "sampler": ["17", 0],
      "sigmas": ["9", 0], "latent_image": ["104", 1]
    },
    "_meta": { "title": "采样" }
  },
  "10": { "class_type": "VAEDecode", "inputs": { "samples": ["14", 0], "vae": ["11", 0] }, "_meta": { "title": "解画面" } },
  "23": { "class_type": "VAEDecodeAudio", "inputs": { "samples": ["14", 0], "vae": ["24", 0] }, "_meta": { "title": "解声音" } },
  "91": {
    "class_type": "CreateVideo",
    "inputs": { "images": ["10", 0], "audio": ["23", 0], "fps": 24 },
    "_meta": { "title": "画面 + 声音" }
  },
  "92": {
    "class_type": "SaveVideo",
    "inputs": { "video": ["91", 0], "filename_prefix": "影匠片", "format": "auto", "codec": "auto" },
    "_meta": { "title": "存视频" }
  },

  "_规格": {
    "来源": "官方 video_minimax_h3_i2v.json 的骨架 + 把 last_frame 也接上两张 LoadImage。",
    "两个 LoadImage 的顺序": "引擎按节点号从小到大认：**5 = 首帧，7 = 尾帧**。要加第三张（参考图）就往后排 8、9。",
    "可缺": [],
    "要求": [
      { "节点": "UNETLoader", "字段": "unet_name", "名字须含": ["minimax_h3"] },
      { "节点": "CLIPLoader", "字段": "type", "等于": "minimax" }
    ]
  }
}
