{
  "_说明": "MiniMax-H3 参考图转视频（r2v）—— **这是锁脸的正路**。给最多 3 张参考图（人物定妆照 / 场景 / 道具），模型生成时把这些形象锁住，比现在靠「种子 + 外貌串」稳得多。占位符：__REF0__ / __REF1__ / __REF2__（可选）/ __POS__ / __SEED__ 由 引擎.图生视频 换。",

  "_图槽": ["参考1", "参考2", "参考3"],

  "127": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "minimax_h3_hybrid_fl2va_ref2va_b25-49-int8.safetensors", "weight_dtype": "default" },
    "_meta": { "title": "MiniMax-H3 hybrid fl2va+ref2va（参考图→视频+音频）" }
  },

  "145": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["127", 0],
      "lora_name": "minimax_h3_ref2v_turbo_4step_v0.1_comfyui_bf16.safetensors",
      "strength_model": 1.0
    },
    "_meta": { "title": "4 步加速 LoRA" }
  },

  "128": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors", "type": "minimax", "device": "default" },
    "_meta": { "title": "文本/视觉编码器" }
  },

  "119": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_video_vae_int8_convrot.safetensors" },
    "_meta": { "title": "视频 VAE" }
  },

  "120": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_audio_vae_fp32.safetensors" },
    "_meta": { "title": "音频 VAE" }
  },

  "137": {
    "class_type": "LoadImage",
    "inputs": { "image": "__REF0__", "upload": "image" },
    "_meta": { "title": "参考图 1（人物定妆照）" }
  },

  "139": {
    "class_type": "LoadImage",
    "inputs": { "image": "__REF1__", "upload": "image" },
    "_meta": { "title": "参考图 2（另一个人 / 场景）" }
  },

  "136": {
    "class_type": "MiniMaxH3ReferenceToVideo",
    "inputs": {
      "clip": ["128", 0],
      "vae": ["119", 0],
      "audio_vae": ["120", 0],
      "prompt": "__POS__",
      "width": 832,
      "height": 480,
      "length": 124,
      "ref_image_size": "match",
      "ref_images.ref_image_0": ["137", 0],
      "ref_images.ref_image_1": ["139", 0]
    },
    "_meta": { "title": "参考图转视频" }
  },

  "15": { "class_type": "RandomNoise", "inputs": { "noise_seed": "__SEED__" }, "_meta": { "title": "噪声种子" } },
  "17": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "res_multistep" }, "_meta": { "title": "采样器" } },
  "9": {
    "class_type": "BasicScheduler",
    "inputs": { "model": ["145", 0], "scheduler": "simple", "steps": 4, "denoise": 1.0 },
    "_meta": { "title": "4 步（配 4 步 LoRA）" }
  },
  "16": {
    "class_type": "BasicGuider",
    "inputs": { "model": ["145", 0], "conditioning": ["136", 0] },
    "_meta": { "title": "引导" }
  },
  "14": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["15", 0], "guider": ["16", 0], "sampler": ["17", 0],
      "sigmas": ["9", 0], "latent_image": ["136", 1]
    },
    "_meta": { "title": "采样" }
  },
  "10": { "class_type": "VAEDecode", "inputs": { "samples": ["14", 0], "vae": ["119", 0] }, "_meta": { "title": "解画面" } },
  "23": { "class_type": "VAEDecodeAudio", "inputs": { "samples": ["14", 0], "vae": ["120", 0] }, "_meta": { "title": "解声音" } },
  "91": {
    "class_type": "CreateVideo",
    "inputs": { "images": ["10", 0], "audio": ["23", 0], "fps": 24 },
    "_meta": { "title": "画面 + 声音" }
  },
  "92": {
    "class_type": "SaveVideo",
    "inputs": { "video": ["91", 0], "filename_prefix": "影匠片", "format": "auto", "codec": "auto" },
    "_meta": { "title": "存视频" }
  },

  "_规格": {
    "来源": "官方 video_minimax_h3_r2v.json 的骨架。本机没有它写的那两个文件名，换成本机有的：UNET 用 minimax_h3_ref2va_pruned_w6a8，LoRA 用 ref2v_turbo_4step_v0.1。",
    "图槽": "引擎按节点号从小到大把 LoadImage 填进去：137→参考1，139→参考2。要第三张就在 136 的 inputs 里加 ref_images.ref_image_2，并新增一个节点号更大的 LoadImage。",
    "可缺": ["参考2", "参考3"],
    "要求": [
      { "节点": "UNETLoader", "字段": "unet_name", "名字须含": ["minimax_h3"] },
      { "节点": "CLIPLoader", "字段": "type", "等于": "minimax" }
    ]
  }
}
